{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "CloudLabs Stage 1 - Oracle Backup, Recovery & Diagnostics on Amazon Linux 2023. WARNING: open password SSH, unrestricted clgSg, and password outputs are intentionally insecure disposable-lab conventions.",
  "Metadata": {
    "AWS::CloudFormation::Interface": {
      "ParameterGroups": [
        {
          "Label": { "default": "CloudLabs deployment" },
          "Parameters": [ "CloudLabsDeploymentID", "CheckAcknowledgement" ]
        },
        {
          "Label": { "default": "Disposable lab access" },
          "Parameters": [ "AdminCidr", "VMUserName", "VMPassword" ]
        },
        {
          "Label": { "default": "Compute and bootstrap" },
          "Parameters": [ "InstanceType", "BootstrapScriptUrl", "AmazonECSTaskExecutionRolePolicy" ]
        }
      ],
      "ParameterLabels": {
        "AdminCidr": { "default": "SSH source CIDR (narrow before launch)" },
        "VMPassword": { "default": "Disposable lab SSH password (also exposed as a stack output)" },
        "BootstrapScriptUrl": { "default": "Canonical userdata.sh URL" }
      }
    },
    "BootstrapContract": {
      "OperatingSystem": "Amazon Linux 2023 x86_64",
      "SignalOwner": "standalone-userdata.sh-after-successful-download",
      "RequiredEnvironment": "CLOUDLABS_DEPLOYMENT_ID,DEPLOYMENT_ID,CFN_STACK,CFN_RESOURCE,ADMIN_USERNAME,ADMIN_PASSWORD,AWS_REGION,BACKUP_VOLUME_ID",
      "FailureBehavior": "The wrapper signals LabVm failure when download or pre-execution validation fails. After execution begins, userdata.sh owns failure trapping, readiness, and the single success signal.",
      "SecurityNote": "No shell tracing is enabled and secret values are not printed. CloudFormation Outputs are not secret storage."
    }
  },
  "Parameters": {
    "CloudLabsDeploymentID": {
      "Type": "String",
      "Description": "CloudLabs deployment identifier used in resource Name tags."
    },
    "CheckAcknowledgement": {
      "Type": "String",
      "Default": "TRUE",
      "AllowedValues": [ "TRUE", "FALSE" ],
      "Description": "PAYNOTIFY-compatible acknowledgement parameter."
    },
    "AmazonECSTaskExecutionRolePolicy": {
      "Type": "String",
      "Default": "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy",
      "Description": "Managed policy ARN attached to the ECS task execution role."
    },
    "AdminCidr": {
      "Type": "String",
      "Default": "0.0.0.0/0",
      "AllowedPattern": "^(?:\\d{1,3}\\.){3}\\d{1,3}/(?:[0-9]|[12][0-9]|3[0-2])$",
      "ConstraintDescription": "Enter an IPv4 CIDR. The default is intentionally insecure; narrow it before launch.",
      "Description": "IPv4 CIDR allowed to use password SSH. Disposable-lab default is open to the internet."
    },
    "VMUserName": {
      "Type": "String",
      "Default": "oraclelab",
      "MinLength": 1,
      "MaxLength": 32,
      "AllowedPattern": "^[a-z_][a-z0-9_-]*$",
      "ConstraintDescription": "Use a lowercase Linux account name of at most 32 characters."
    },
    "VMPassword": {
      "Type": "String",
      "NoEcho": true,
      "MinLength": 12,
      "MaxLength": 64,
      "AllowedPattern": "^(?=.*[a-z])(?=.*[A-Z])(?=.*[0-9])(?=.*[^A-Za-z0-9])[^\\s'\\\"`$\\\\]{12,64}$",
      "ConstraintDescription": "Use 12-64 characters with uppercase, lowercase, number, and symbol; spaces, quotes, backticks, dollar signs, and backslashes are not allowed."
    },
    "InstanceType": {
      "Type": "String",
      "Default": "t3.large",
      "AllowedValues": [ "t3.medium", "t3.large", "t3.xlarge" ],
      "Description": "Lab EC2 type. t3.large is the tested baseline."
    },
    "BootstrapScriptUrl": {
      "Type": "String",
      "Default": "https://raw.githubusercontent.com/fardeena-spektra/OCIDB/refs/heads/main/Userdata/userdata.sh",
      "AllowedPattern": "^https://.+/userdata[.]sh(?:[?].*)?$",
      "ConstraintDescription": "Provide an HTTPS URL for the canonical userdata.sh Bash artifact.",
      "Description": "Canonical standalone Amazon Linux 2023 bootstrap. The script owns normal failure trapping, readiness, and final success signaling."
    }
  },
  "Resources": {
    "LabVpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.42.0.0/16",
        "EnableDnsHostnames": true,
        "EnableDnsSupport": true,
        "InstanceTenancy": "default",
        "Tags": [
          { "Key": "Name", "Value": { "Fn::Sub": "${CloudLabsDeploymentID}-vpc" } },
          { "Key": "CloudLabsLab", "Value": "OracleRecoveryDiagnostics" }
        ]
      }
    },
    "InternetGateway": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {
        "Tags": [ { "Key": "Name", "Value": { "Fn::Sub": "${CloudLabsDeploymentID}-igw" } } ]
      }
    },
    "VpcGatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "InternetGatewayId": { "Ref": "InternetGateway" },
        "VpcId": { "Ref": "LabVpc" }
      }
    },
    "PublicSubnet": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "AvailabilityZone": { "Fn::Select": [ 0, { "Fn::GetAZs": "" } ] },
        "CidrBlock": "10.42.1.0/24",
        "MapPublicIpOnLaunch": true,
        "VpcId": { "Ref": "LabVpc" },
        "Tags": [ { "Key": "Name", "Value": { "Fn::Sub": "${CloudLabsDeploymentID}-public-subnet" } } ]
      }
    },
    "PublicRouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": { "Ref": "LabVpc" },
        "Tags": [ { "Key": "Name", "Value": { "Fn::Sub": "${CloudLabsDeploymentID}-public-route-table" } } ]
      }
    },
    "DefaultPublicRoute": {
      "Type": "AWS::EC2::Route",
      "DependsOn": "VpcGatewayAttachment",
      "Properties": {
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": { "Ref": "InternetGateway" },
        "RouteTableId": { "Ref": "PublicRouteTable" }
      }
    },
    "PublicSubnetRouteTableAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "RouteTableId": { "Ref": "PublicRouteTable" },
        "SubnetId": { "Ref": "PublicSubnet" }
      }
    },
    "LabSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Password SSH for disposable Oracle lab; narrow AdminCidr before launch",
        "SecurityGroupEgress": [
          {
            "IpProtocol": "-1",
            "CidrIp": "0.0.0.0/0",
            "Description": "Internet egress for package, registry, and AWS endpoints"
          }
        ],
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 22,
            "ToPort": 22,
            "CidrIp": { "Ref": "AdminCidr" },
            "Description": "Intentionally password-enabled disposable-lab SSH"
          }
        ],
        "VpcId": { "Ref": "LabVpc" },
        "Tags": [ { "Key": "Name", "Value": { "Fn::Sub": "${CloudLabsDeploymentID}-vm-sg" } } ]
      }
    },
    "clgSg": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "PAYNOTIFY lab-only unrestricted IPv4 and IPv6 security group",
        "VpcId": { "Ref": "LabVpc" },
        "SecurityGroupIngress": [
          { "IpProtocol": "-1", "CidrIp": "0.0.0.0/0", "Description": "Lab-only unrestricted IPv4 ingress" },
          { "IpProtocol": "-1", "CidrIpv6": "::/0", "Description": "Lab-only unrestricted IPv6 ingress" }
        ],
        "SecurityGroupEgress": [
          { "IpProtocol": "-1", "CidrIp": "0.0.0.0/0", "Description": "Lab-only unrestricted IPv4 egress" },
          { "IpProtocol": "-1", "CidrIpv6": "::/0", "Description": "Lab-only unrestricted IPv6 egress" }
        ],
        "Tags": [ { "Key": "Name", "Value": { "Fn::Sub": "${CloudLabsDeploymentID}-cluster-sg" } } ]
      }
    },
    "LabInstanceRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": { "Service": [ "ec2.amazonaws.com" ] },
              "Action": [ "sts:AssumeRole" ]
            }
          ]
        },
        "Description": "Instance role limited to Systems Manager core management; backups remain on EBS.",
        "ManagedPolicyArns": [ "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore" ],
        "Path": "/cloudlabs/oracle-recovery/",
        "Tags": [
          { "Key": "CloudLabsProtected", "Value": "true" },
          { "Key": "CloudLabsLab", "Value": "OracleRecoveryDiagnostics" }
        ]
      }
    },
    "LabInstanceProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "Path": "/cloudlabs/oracle-recovery/",
        "Roles": [ { "Ref": "LabInstanceRole" } ]
      }
    },
    "TaskExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": { "Service": [ "ecs-tasks.amazonaws.com" ] },
              "Action": [ "sts:AssumeRole" ]
            }
          ]
        },
        "Description": "PAYNOTIFY-compatible ECS task execution role.",
        "ManagedPolicyArns": [ { "Ref": "AmazonECSTaskExecutionRolePolicy" } ],
        "Tags": [ { "Key": "CloudLabsDeploymentID", "Value": { "Ref": "CloudLabsDeploymentID" } } ]
      }
    },
    "BackupVolume": {
      "Type": "AWS::EC2::Volume",
      "DeletionPolicy": "Delete",
      "UpdateReplacePolicy": "Delete",
      "Properties": {
        "AvailabilityZone": { "Fn::GetAtt": [ "PublicSubnet", "AvailabilityZone" ] },
        "Encrypted": true,
        "Iops": 3000,
        "Size": 30,
        "Throughput": 125,
        "VolumeType": "gp3",
        "Tags": [
          { "Key": "Name", "Value": { "Fn::Sub": "${CloudLabsDeploymentID}-oracle-backup" } },
          { "Key": "MountPoint", "Value": "/u02/backup" },
          { "Key": "CloudLabsLab", "Value": "OracleRecoveryDiagnostics" }
        ]
      }
    },
    "LabVm": {
      "Type": "AWS::EC2::Instance",
      "DependsOn": [
        "DefaultPublicRoute",
        "PublicSubnetRouteTableAssociation",
        "LabInstanceProfile",
        "BackupVolume"
      ],
      "CreationPolicy": {
        "ResourceSignal": {
          "Count": 1,
          "Timeout": "PT60M"
        }
      },
      "Properties": {
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/xvda",
            "Ebs": {
              "DeleteOnTermination": true,
              "Encrypted": true,
              "Iops": 3000,
              "VolumeSize": 50,
              "VolumeType": "gp3"
            }
          }
        ],
        "IamInstanceProfile": { "Ref": "LabInstanceProfile" },
        "ImageId": "{{resolve:ssm:/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64}}",
        "InstanceType": { "Ref": "InstanceType" },
        "MetadataOptions": {
          "HttpEndpoint": "enabled",
          "HttpPutResponseHopLimit": 1,
          "HttpTokens": "required",
          "InstanceMetadataTags": "disabled"
        },
        "SecurityGroupIds": [ { "Fn::GetAtt": [ "LabSecurityGroup", "GroupId" ] } ],
        "SubnetId": { "Ref": "PublicSubnet" },
        "Tags": [
          { "Key": "Name", "Value": "labvm" },
          { "Key": "CloudLabsDeploymentID", "Value": { "Ref": "CloudLabsDeploymentID" } },
          { "Key": "CloudLabsLab", "Value": "OracleRecoveryDiagnostics" },
          { "Key": "CloudLabsManaged", "Value": "true" }
        ],
        "Volumes": [
          {
            "Device": "/dev/sdf",
            "VolumeId": { "Ref": "BackupVolume" }
          }
        ],
        "UserData": {
          "Fn::Base64": {
            "Fn::Sub": "#!/bin/bash\nset -Eeuo pipefail\numask 077\nexec >>/var/log/cloudlabs-userdata-wrapper.log 2>&1\n\n# Export required inputs without xtrace or printing secret values.\nexport CLOUDLABS_DEPLOYMENT_ID='${CloudLabsDeploymentID}'\nexport DEPLOYMENT_ID='${CloudLabsDeploymentID}'\nexport CFN_STACK='${AWS::StackName}'\nexport CFN_RESOURCE='LabVm'\nexport ADMIN_USERNAME='${VMUserName}'\nexport ADMIN_PASSWORD='${VMPassword}'\nexport AWS_REGION='${AWS::Region}'\nexport BACKUP_VOLUME_ID='${BackupVolume}'\n\ninstall -d -m 0700 /opt/lab\nBOOTSTRAP=/opt/lab/userdata.sh\n\n# The wrapper owns only download/pre-execution failure signaling.\nif ! curl --fail --silent --show-error --location --retry 3 '${BootstrapScriptUrl}' --output \"$BOOTSTRAP\"; then\n  /opt/aws/bin/cfn-signal --success false --reason 'Failed to download userdata.sh' --stack \"$CFN_STACK\" --resource LabVm --region \"$AWS_REGION\" || true\n  exit 1\nfi\n\n# Canonical artifact must use Unix LF and have #!/bin/bash as byte/line one.\nsed -i 's/\\r$//' \"$BOOTSTRAP\"\nif [ \"$(head -n 1 \"$BOOTSTRAP\")\" != '#!/bin/bash' ]; then\n  /opt/aws/bin/cfn-signal --success false --reason 'userdata.sh failed shebang validation' --stack \"$CFN_STACK\" --resource LabVm --region \"$AWS_REGION\" || true\n  exit 1\nfi\nchmod 0700 \"$BOOTSTRAP\"\n\ntest -n \"$CLOUDLABS_DEPLOYMENT_ID\"\ntest -n \"$CFN_STACK\"\ntest -n \"$ADMIN_USERNAME\"\ntest -n \"$ADMIN_PASSWORD\"\ntest -n \"$AWS_REGION\"\ntest -n \"$BACKUP_VOLUME_ID\"\n\n# Do not signal success here. userdata.sh owns normal failure trapping, readiness, and final signaling.\nexec \"$BOOTSTRAP\"\n"
          }
        }
      }
    }
  },
  "Outputs": {
    "CloudLabsDeploymentID": {
      "Value": { "Ref": "CloudLabsDeploymentID" }
    },
    "AWSAccountID": {
      "Value": { "Ref": "AWS::AccountId" }
    },
    "Region": {
      "Value": { "Ref": "AWS::Region" }
    },
    "VpcId": {
      "Value": { "Ref": "LabVpc" }
    },
    "vmSubnetId": {
      "Value": { "Ref": "PublicSubnet" }
    },
    "vmSecurityGroupId": {
      "Value": { "Fn::GetAtt": [ "LabSecurityGroup", "GroupId" ] }
    },
    "clusterSecurityGroupId": {
      "Value": { "Fn::GetAtt": [ "clgSg", "GroupId" ] }
    },
    "TaskExecutionRole": {
      "Value": { "Fn::GetAtt": [ "TaskExecutionRole", "Arn" ] }
    },
    "InstanceId": {
      "Value": { "Ref": "LabVm" }
    },
    "VMName": {
      "Value": "labvm"
    },
    "VMPublicIP": {
      "Value": { "Fn::GetAtt": [ "LabVm", "PublicIp" ] }
    },
    "VMPrivateIP": {
      "Value": { "Fn::GetAtt": [ "LabVm", "PrivateIp" ] }
    },
    "VMPublicDNSName": {
      "Value": { "Fn::GetAtt": [ "LabVm", "PublicDnsName" ] }
    },
    "VMPrivateDNSName": {
      "Value": { "Fn::GetAtt": [ "LabVm", "PrivateDnsName" ] }
    },
    "VMUserName": {
      "Value": { "Ref": "VMUserName" }
    },
    "VMPassword": {
      "Description": "DISPOSABLE LAB ONLY: CloudFormation outputs are not secret storage",
      "Value": { "Ref": "VMPassword" }
    },
    "BackupVolumeId": {
      "Value": { "Ref": "BackupVolume" }
    },
    "BackupMount": {
      "Value": "/u02/backup"
    },
    "OracleContainerName": {
      "Value": "oracle-free"
    },
    "OracleServices": {
      "Value": "FREE,FREEPDB1"
    },
    "OracleListenerPort": {
      "Value": "1521"
    },
    "SSMTarget": {
      "Value": { "Ref": "LabVm" }
    }
  }
}
